# Supabase Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Assistant LLM Key (Optional - enables Gemini/LLM grounded mode)
BIS_LLM_API_KEY=your_gemini_or_llm_key

# Authentication Secret Key (generate a strong key in production)
SECRET_KEY=bis-standards-secret-key-super-secure-min-32-chars-2026

# Embedding Mode ("on" or "off" - defaults to off for rapid startup)
BIS_EMBEDDINGS=off
