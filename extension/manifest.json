{
  "manifest_version": 3,
  "name": "AI Shield — Harmful Content Blur",
  "version": "1.0.0",
  "description": "Blurs toxic text and NSFW images on any website using your local AI Shield model server.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Shield"
  },
  "icons": {
    "128": "icon128.png"
  }
}
